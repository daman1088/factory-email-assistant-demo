# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored), or paste the same lines into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit real secrets.

# Shared code visitors type to open the demo. Use a long random phrase and share it privately.
DEMO_ACCESS_CODE = "change-me-to-a-long-random-phrase"

# Optional: "fastembed" (default; local semantic search, downloads a ~130 MB model at start-up)
# or "fake" (keyword similarity only; faster start-up).
# DEMO_EMBEDDINGS = "fastembed"
